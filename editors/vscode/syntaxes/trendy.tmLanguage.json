{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Generated from the lexer by crates/lsp/tests/textmate.rs. Do not edit: run `UPDATE_TEXTMATE=1 cargo test -p trendy_lsp --test textmate`.",
  "name": "trendy",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#operator-definition"
    },
    {
      "include": "#builtin-type"
    },
    {
      "include": "#call"
    },
    {
      "include": "#variable-declaration"
    },
    {
      "include": "#key"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operator-word"
    },
    {
      "include": "#boolean"
    },
    {
      "include": "#number"
    },
    {
      "include": "#text"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "boolean": {
      "match": "\\b(?:true|false)\\b",
      "name": "constant.language.boolean.trendy"
    },
    "builtin-type": {
      "captures": {
        "1": {
          "name": "keyword.other.trendy"
        },
        "2": {
          "name": "keyword.other.trendy"
        },
        "3": {
          "name": "entity.name.type.trendy"
        }
      },
      "match": "\\b(builtin)\\s+(type)\\s+([A-Z_a-z][0-9A-Z_a-z]*)"
    },
    "call": {
      "captures": {
        "1": {
          "name": "keyword.other.trendy"
        },
        "2": {
          "name": "entity.name.function.trendy"
        }
      },
      "match": "\\b(call)\\s+([A-Z_a-z][0-9A-Z_a-z]*)"
    },
    "comment": {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.trendy",
      "patterns": [
        {
          "include": "#comment"
        }
      ]
    },
    "key": {
      "captures": {
        "1": {
          "name": "keyword.other.trendy"
        }
      },
      "match": "\\b(key)\\s*(?=\\{)"
    },
    "keywords": {
      "match": "\\b(?:operator|var|tuple|relation|call|builtin|as|insert|d_insert|delete|i_delete|update|assign)\\b",
      "name": "keyword.other.trendy"
    },
    "number": {
      "match": "\\b[0-9](?:[eE][+\\-]|[\\x{2E}0-9A-Z_a-z])*",
      "name": "constant.numeric.trendy"
    },
    "operator-definition": {
      "captures": {
        "1": {
          "name": "keyword.other.trendy"
        },
        "2": {
          "name": "entity.name.function.trendy"
        }
      },
      "match": "\\b(operator)\\s+([A-Z_a-z][0-9A-Z_a-z]*)"
    },
    "operator-word": {
      "match": "\\b(?:not|and|or|xor|implies|div|mod|remove|rename|extend|replace|group|ungroup|wrap|unwrap|join|times|compose|matching|union|d_union|xunion|intersect|minus|i_minus|where)\\b",
      "name": "keyword.operator.word.trendy"
    },
    "punctuation": {
      "patterns": [
        {
          "match": "\\:\\=",
          "name": "keyword.operator.assignment.trendy"
        },
        {
          "match": "\\<\\>|\\<\\=|\\>\\=|\\=|\\<|\\>",
          "name": "keyword.operator.comparison.trendy"
        },
        {
          "match": "\\|\\|",
          "name": "keyword.operator.concatenation.trendy"
        },
        {
          "match": "\\!\\!",
          "name": "keyword.operator.image.trendy"
        },
        {
          "match": "\\{|\\}",
          "name": "punctuation.section.braces.trendy"
        },
        {
          "match": "\\[|\\]",
          "name": "punctuation.section.brackets.trendy"
        },
        {
          "match": "\\(|\\)",
          "name": "punctuation.section.parens.trendy"
        },
        {
          "match": "\\:",
          "name": "punctuation.separator.type.trendy"
        },
        {
          "match": "\\,",
          "name": "punctuation.separator.comma.trendy"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.trendy"
        },
        {
          "match": "\\;",
          "name": "punctuation.terminator.trendy"
        },
        {
          "match": "\\+|\\-|\\*|\\/",
          "name": "keyword.operator.arithmetic.trendy"
        }
      ]
    },
    "text": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.trendy",
      "patterns": [
        {
          "match": "\\\\(?:[\\\"\\\\nrt0]|u\\{[0-9A-Fa-f]{1,6}\\})",
          "name": "constant.character.escape.trendy"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.trendy"
        }
      ]
    },
    "variable-declaration": {
      "captures": {
        "1": {
          "name": "keyword.other.trendy"
        },
        "2": {
          "name": "variable.other.definition.trendy"
        },
        "3": {
          "name": "punctuation.separator.type.trendy"
        },
        "4": {
          "name": "entity.name.type.trendy"
        }
      },
      "match": "\\b(var)\\s+([A-Z_a-z][0-9A-Z_a-z]*)(?:\\s*(\\:)\\s*(?!(?:operator|var|true|false|tuple|relation|call|builtin|not|and|or|xor|implies|div|mod|remove|rename|extend|replace|group|ungroup|wrap|unwrap|join|times|compose|matching|union|d_union|xunion|intersect|minus|i_minus|where|as|insert|d_insert|delete|i_delete|update|assign)\\b)([A-Z_a-z][0-9A-Z_a-z]*))?"
    }
  },
  "scopeName": "source.trendy"
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Generated from the lexer by crates/lsp/tests/textmate.rs. Do not edit: run `UPDATE_TEXTMATE=1 cargo test -p trendy_lsp --test textmate`.",
  "name": "trendy",
  "patterns": [
    {
      "include": "#operator-definition"
    },
    {
      "include": "#variable-declaration"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#boolean"
    },
    {
      "include": "#number"
    },
    {
      "include": "#text"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "boolean": {
      "match": "\\b(?:true|false)\\b",
      "name": "constant.language.boolean.trendy"
    },
    "keywords": {
      "match": "\\b(?:operator|var|tuple|relation)\\b",
      "name": "keyword.other.trendy"
    },
    "number": {
      "match": "\\b[0-9](?:[eE][+\\-]|[\\x{2E}0-9A-Z_a-z])*",
      "name": "constant.numeric.trendy"
    },
    "operator-definition": {
      "captures": {
        "1": {
          "name": "keyword.other.trendy"
        },
        "2": {
          "name": "entity.name.function.trendy"
        }
      },
      "match": "\\b(operator)\\s+([A-Z_a-z][0-9A-Z_a-z]*)"
    },
    "punctuation": {
      "patterns": [
        {
          "match": "\\:\\=",
          "name": "keyword.operator.assignment.trendy"
        },
        {
          "match": "\\{|\\}",
          "name": "punctuation.section.braces.trendy"
        },
        {
          "match": "\\[|\\]",
          "name": "punctuation.section.brackets.trendy"
        },
        {
          "match": "\\(|\\)",
          "name": "punctuation.section.parens.trendy"
        },
        {
          "match": "\\:",
          "name": "punctuation.separator.type.trendy"
        },
        {
          "match": "\\,",
          "name": "punctuation.separator.comma.trendy"
        },
        {
          "match": "\\=",
          "name": "keyword.operator.comparison.trendy"
        },
        {
          "match": "\\;",
          "name": "punctuation.terminator.trendy"
        }
      ]
    },
    "text": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.trendy",
      "patterns": [
        {
          "match": "\\\\(?:[\\\"\\\\nrt0]|u\\{[0-9A-Fa-f]{1,6}\\})",
          "name": "constant.character.escape.trendy"
        },
        {
          "match": "\\\\.",
          "name": "invalid.illegal.escape.trendy"
        }
      ]
    },
    "variable-declaration": {
      "captures": {
        "1": {
          "name": "keyword.other.trendy"
        },
        "2": {
          "name": "variable.other.definition.trendy"
        },
        "3": {
          "name": "punctuation.separator.type.trendy"
        },
        "4": {
          "name": "entity.name.type.trendy"
        }
      },
      "match": "\\b(var)\\s+([A-Z_a-z][0-9A-Z_a-z]*)(?:\\s*(\\:)\\s*(?!(?:operator|var|true|false|tuple|relation)\\b)([A-Z_a-z][0-9A-Z_a-z]*))?"
    }
  },
  "scopeName": "source.trendy"
}

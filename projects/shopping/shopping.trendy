/* A shopping list: the ingredients for the week's planned meals, each
   recipe scaled to the number of people it's cooked for, and summed across
   recipes.

   The first project written in trendy, to find out what the language needs
   by using it. What it can't say yet is written below as it should read,
   in comments, in the order the features are needed. */

/* Each recipe, its name in its own script, and how many people it serves
   as written. */
var recipes := relation {
    { recipe: "shakshuka", native_name: "شكشوكة", serves: 4 },
    { recipe: "dal tadka", native_name: "दाल तड़का", serves: 4 },
    { recipe: "mapo doufu", native_name: "麻婆豆腐", serves: 3 },
    { recipe: "borshch", native_name: "борщ", serves: 6 },
}
key { recipe }
key { native_name };

/* What each recipe needs, for the people it serves. An ingredient always
   comes in one unit, so quantities of it can be added up. That is a
   constraint too, but not a key, since it holds across recipes. */
var ingredients := relation {
    { recipe: "shakshuka", ingredient: "egg", quantity: 6e0, unit: "piece" },
    { recipe: "shakshuka", ingredient: "tomato", quantity: 800e0, unit: "g" },
    { recipe: "shakshuka", ingredient: "onion", quantity: 1e0, unit: "piece" },
    { recipe: "shakshuka", ingredient: "garlic", quantity: 3e0, unit: "clove" },
    { recipe: "shakshuka", ingredient: "cumin", quantity: 5e0, unit: "g" },
    { recipe: "shakshuka", ingredient: "olive oil", quantity: 30e0, unit: "ml" },
    { recipe: "dal tadka", ingredient: "red lentils", quantity: 250e0, unit: "g" },
    { recipe: "dal tadka", ingredient: "tomato", quantity: 200e0, unit: "g" },
    { recipe: "dal tadka", ingredient: "onion", quantity: 1e0, unit: "piece" },
    { recipe: "dal tadka", ingredient: "garlic", quantity: 4e0, unit: "clove" },
    { recipe: "dal tadka", ingredient: "ginger", quantity: 10e0, unit: "g" },
    { recipe: "dal tadka", ingredient: "cumin", quantity: 5e0, unit: "g" },
    { recipe: "dal tadka", ingredient: "ghee", quantity: 30e0, unit: "g" },
    { recipe: "mapo doufu", ingredient: "tofu", quantity: 400e0, unit: "g" },
    { recipe: "mapo doufu", ingredient: "minced pork", quantity: 150e0, unit: "g" },
    { recipe: "mapo doufu", ingredient: "garlic", quantity: 3e0, unit: "clove" },
    { recipe: "mapo doufu", ingredient: "ginger", quantity: 15e0, unit: "g" },
    { recipe: "mapo doufu", ingredient: "doubanjiang", quantity: 30e0, unit: "g" },
    { recipe: "mapo doufu", ingredient: "Sichuan pepper", quantity: 3e0, unit: "g" },
    { recipe: "borshch", ingredient: "beetroot", quantity: 500e0, unit: "g" },
    { recipe: "borshch", ingredient: "cabbage", quantity: 300e0, unit: "g" },
    { recipe: "borshch", ingredient: "potato", quantity: 300e0, unit: "g" },
    { recipe: "borshch", ingredient: "carrot", quantity: 1e0, unit: "piece" },
    { recipe: "borshch", ingredient: "onion", quantity: 1e0, unit: "piece" },
    { recipe: "borshch", ingredient: "garlic", quantity: 2e0, unit: "clove" },
}
key { recipe, ingredient };

/* This week's meals, and how many people each is cooked for. No borshch
   this week, so none of its ingredients belong on the list. */
var plan := relation {
    { recipe: "shakshuka", people: 4 },
    { recipe: "dal tadka", people: 4 },
    { recipe: "mapo doufu", people: 6 },
}
key { recipe };

/* Each planned meal with its recipe and ingredients. Joining with the
   plan also leaves out the recipes not planned. */
var planned := join{plan, recipes, ingredients};

/* Each planned meal's ingredients, scaled from the people its recipe
   serves to the people it's cooked for. Values never convert implicitly,
   so the counts of people, integers, are converted to approximate
   numbers. */
var scaled := planned extend {
    amount := quantity * to_approximate{from: people} / to_approximate{from: serves}
};

/* What to buy: each ingredient and its unit, with the sum of its amounts
   in its image relation in `scaled`, the tuples for that ingredient, and
   the recipes that need it. The sum is of those tuples, not of their
   distinct amounts: cumin is 5 g in both shakshuka and dal tadka, and the
   list needs 10 g. The image relation keeps `recipe`, so both are
   there. */
var list := scaled{ingredient, unit} extend {
    total := sum{r: !!scaled, of: amount},
    recipes := (!!scaled){recipe}
};

/* What it can't say yet, as it should read once the language has what it
   needs: a pantry to subtract what's already at home, which needs storage,
   and output for people rather than `debug_value`. */

operator main{} [
    call debug_value{v: plan};
    call debug_value{v: list};
];

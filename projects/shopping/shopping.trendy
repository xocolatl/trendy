/* A shopping list: the ingredients for the week's planned meals, each
   recipe scaled to the number of people it's cooked for, and summed across
   recipes. The recipes, their ingredients and the week's plan are CSV
   files beside it, which it reads when it runs.

   The first project written in trendy, to find out what the language needs
   by using it. What it can't say yet is written below as it should read,
   in comments, in the order the features are needed. */

/* Each recipe, its name in its own script, and how many people it serves
   as written. */
heading recipe := { recipe: text, native_name: text, serves: integer };

/* An ingredient a recipe needs, how much of it, and in which unit, for
   the people the recipe serves. */
heading need := { recipe: text, ingredient: text, quantity: approximate, unit: text };

/* A meal of the week's, and how many people it's cooked for. */
heading meal := { recipe: text, people: integer };

/* The recipes, which `recipes.csv` lists. */
var recipes: relation recipe key { recipe } key { native_name };

/* What each recipe needs, which `ingredients.csv` lists. An ingredient
   always comes in one unit, so quantities of it can be added up. That is
   a constraint too, but not a key, since it holds across recipes. */
var ingredients: relation need key { recipe, ingredient };

/* This week's meals, which `plan.csv` lists. No borshch this week, so
   none of its ingredients belong on the list. */
var plan: relation meal key { recipe };

/* Read the recipes, their ingredients and the plan from their CSV files,
   from the directory the program runs in, the project's. Each file has a
   header, and the call names the columns: a file's columns have an order
   and no names. Each file's records are an array, and loading a variable
   from it makes a relation, in which equal lines are one, and which the
   variable's keys hold of: two lines that give one recipe different
   values stop the program. */
operator load_week{} [
    var recipe_rows: array tuple recipe;
    call load_csv{
        path: "recipes.csv",
        header: true,
        columns: tuple { recipe: 1, native_name: 2, serves: 3 },
        out rows: recipe_rows,
    };
    load recipes from recipe_rows;
    var need_rows: array tuple need;
    call load_csv{
        path: "ingredients.csv",
        header: true,
        columns: tuple { recipe: 1, ingredient: 2, quantity: 3, unit: 4 },
        out rows: need_rows,
    };
    load ingredients from need_rows;
    var meal_rows: array tuple meal;
    call load_csv{
        path: "plan.csv",
        header: true,
        columns: tuple { recipe: 1, people: 2 },
        out rows: meal_rows,
    };
    load plan from meal_rows;
];

/* An ingredient to buy, in its unit, how much of it, and the recipes that
   need it. */
heading item := {
    ingredient: text,
    unit: text,
    total: approximate,
    recipes: relation { recipe: text },
};

/* What to buy for the meals of `plan`, cooked from `recipes` with
   `ingredients`: a function of them, so a read-only operator. */
operator shopping_list{
    plan: relation meal,
    recipes: relation recipe,
    ingredients: relation need,
}: relation item [
    /* Each planned meal with its recipe and ingredients. Joining with the
       plan also leaves out the recipes not planned. */
    var planned := join{plan, recipes, ingredients};
    /* Each planned meal's ingredients, scaled from the people its recipe
       serves to the people it's cooked for. Values never convert
       implicitly, so the counts of people, integers, are converted to
       approximate numbers. */
    var scaled := planned extend {
        amount := quantity * to_approximate{from: people} / to_approximate{from: serves},
    };
    /* Each ingredient and its unit, with the sum of its amounts in its
       image relation in `scaled`, the tuples for that ingredient, and the
       recipes that need it. The sum is of those tuples, not of their
       distinct amounts: cumin is 5 g in both shakshuka and dal tadka, and
       the list needs 10 g. The image relation keeps `recipe`, so both are
       there. */
    scaled{ingredient, unit} extend {
        total := sum{r: !!scaled, of: amount},
        recipes := (!!scaled){recipe},
    }
];

/* What it can't say yet, as it should read once the language has what it
   needs:

   A pantry, to subtract what's already at home. It changes as food is
   bought and used, so it outlives each run of the program: it is a
   relvar in a database. The database is a variable that persists,
   whose value is a tuple of relations (TTM's dbvar, Appendix D), so its
   type lists them, each with its keys. Only relations go in one. The
   program never names the file it is kept in: by default, it is
   `kitchen.sqlite`, in the directory the program runs in.

     var kitchen: database {
         pantry:
             relation {
                 ingredient: text,
                 quantity: approximate,
                 unit: text,
             }
             key { ingredient },
     };

   Every read and write of a database is in a `transaction` block,
   begun and committed explicitly (TTM OO Prescription 4), which
   touches one database. Reading a relvar is `kitchen.pantry`. Writing
   is `update kitchen { … }`: inside the braces, `pantry` is its value
   in the database, and `insert`, `delete` and `update` apply to it,
   all at once, as one assignment of the whole database. A failure, or
   `rollback;`, undoes the whole transaction, and stops the program.

     operator bought{item: text, added: approximate, unit: text} [
         transaction [
             var held := kitchen.pantry where ingredient = item;
             if is_empty{r: held} then [
                 update kitchen {
                     insert pantry relation { { ingredient: item, quantity: added, unit: unit } },
                 };
             ] else [
                 update kitchen {
                     update pantry { quantity := quantity + added } where ingredient = item,
                 };
             ];
         ];
     ];

     operator used{item: text, taken: approximate} [
         transaction [
             var held := kitchen.pantry where ingredient = item;
             if is_empty{r: held} then [
                 rollback;
             ] else if value from held{quantity} < taken then [
                 rollback;
             ];
             update kitchen {
                 update pantry { quantity := quantity - taken } where ingredient = item,
             };
         ];
     ];

   What to buy is the list less what's at home: the image of each
   ingredient in the pantry is its quantity there, or no tuple, whose
   sum is 0.

     operator main{} [
         call load_week{};
         var list := shopping_list{plan: plan, recipes: recipes, ingredients: ingredients};
         transaction [
             var to_buy := list
                 extend { buy := total - sum{r: !!(kitchen.pantry), of: quantity} }
                 where buy > 0e0;
             call debug_table{r: to_buy{ingredient, buy, unit}};
         ];
     ];

   Later: output for people rather than `debug_table`. */

operator main{} [
    call load_week{};
    call debug_table{r: plan};
    call debug_table{r: shopping_list{plan: plan, recipes: recipes, ingredients: ingredients}};
];

var flag := true;
var count := 42;
var ratio := 1.5e-3;
var big := 1e300;
var greeting := "say \"hi\"\n\ttab \\ é";
var point := tuple { x: 1e0, y: tuple { z: false } };
var unit := tuple {};
var nobody: relation { name: text };
var people := relation {
    { name: "Ada", born: 1815 },
    { name: "Edgar", born: 1923 },
};
var teams := relation { { team: "core", members: relation { { name: "Ada" } } } };
var rainfall := array [1200, 950, 220];
var dry: array text;
var written := tuple {
    greeting: to_text{from: greeting},
    point: to_text{from: point},
    rainfall: to_text{from: rainfall},
    teams: to_text{from: teams},
};

/* `v` as text, which is what `debug_value` writes: made when running, since
   `v` is known only then. */
operator as_text{v: any type} [
    call debug_value{v: to_text{from: v}};
];

operator show{label: text, value: integer} [
    call debug_value{v: label};
    call debug_value{v: value};
];

operator main{} [
    call debug_value{v: flag};
    call debug_value{v: count};
    call debug_value{v: ratio};
    call debug_value{v: big};
    call debug_value{v: greeting};
    call debug_value{v: point};
    call debug_value{v: unit};
    call debug_value{v: nobody};
    call debug_value{v: people};
    call debug_value{v: teams};
    call debug_value{v: rainfall};
    call debug_value{v: dry};
    call debug_value{v: written};
    call debug_value{v: 7};
    call show{value: count, label: "count"};
    call as_text{v: greeting};
    call as_text{v: point};
    call as_text{v: rainfall};
    call as_text{v: teams};
];

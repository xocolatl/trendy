/* The Third Manifesto's example types (chapters 3 and 6), on which
   Type Inheritance and Relational Theory builds its running example of
   inheritance: plane figures, which are ellipses or polygons, of which
   circles are ellipses, rectangles polygons and squares rectangles. Its
   root, `plane_figure`, is a union type, and a dummy type, with no
   possible representation of its own (chapter 12). Circles, rectangles
   and squares are specialized by constraints, which trendy doesn't have
   yet, so for now ellipses and polygons are its subtypes. Each result
   below is printed twice, folded when compiling and computed when
   running, as in types.trendy. */

/* Lengths and angles. A length, here a `distance`, since the prelude's
   `length` of an array has the name, is never negative, and an angle is in
   radians, from 0 up to a full turn, which TTM writes `2 * 3.14159`; both
   are ordinal in Tutorial D, and ordered here. */
type distance {
    { m: approximate },
    constraint m >= 0e0,
    order [asc m],
};
type angle {
    { rho: approximate },
    constraint rho >= 0e0 and rho < 2e0 * pi{},
    order [asc rho],
};

/* A point in two-dimensional space, by its cartesian coordinates or its
   polar ones, within the circle of radius 100 around the origin, as RM
   Prescription 23 has it: TTM writes `SQRT ( X ** 2 + Y ** 2 ) <= 100.0`
   of the cartesian ones and `R <= LENGTH ( 100.0 )` of the polar ones,
   which is the same constraint, since a point's distance from the origin
   is that square root. A constraint can name either's components.

   TTM's points have no order. These are ordered by their polar
   coordinates, nearer the origin first, then from the positive x axis
   anticlockwise: an order, like a constraint, can name the components of
   any one representation.

   Its values are stored by their cartesian coordinates, from which the
   origin's angle is 0, so that it has one polar representation, as RM
   Prescription 8 needs, and TTM's constraint on its polar one, `IF R =
   LENGTH ( 0.0 ) THEN THETA = ANGLE ( 0.0 ) END IF`, always holds. A polar
   selection of the origin at another angle gives the origin. */
type point {
    { x: approximate, y: approximate },
    { r: distance, theta: angle }
        to { x := r.m * cos{of: theta.rho}, y := r.m * sin{of: theta.rho} }
        from { r := distance{m: sqrt{of: x * x + y * y}}, theta := direction{y: y, x: x} },
    constraint r <= distance{m: 100e0},
    order [asc r, asc theta],
};

/* The angle from the positive x axis to the point (x, y): `atan2` gives
   one from -π, exclusive, to π, and a negative one is that much short of
   a full turn, unless so little short that the nearest approximate number
   is the full turn itself, which is the angle 0. */
operator direction{y: approximate, x: approximate}: angle [
    var rho := atan2{y: y, x: x};
    var turned := if rho < 0e0 then rho + 2e0 * pi{} else rho;
    angle{rho: if turned < 2e0 * pi{} then turned else 0e0}
];

/* The distance between two points (TTM's DIST). */
operator dist{p1: point, p2: point}: distance [
    var dx := p1.x - p2.x;
    var dy := p1.y - p2.y;
    distance{m: sqrt{of: dx * dx + dy * dy}}
];

/* A line segment, from one point to another (TTM's LINESEG). */
type lineseg { { begin: point, end: point } };

/* Every plane figure is an ellipse or a polygon: a value of a union type
   is a value of one of its subtypes, each declared `is` it, and has no
   representation of its own, so there is no `plane_figure{…}`. */
type plane_figure union;

/* An ellipse, by its major and minor semiaxes, the major at least as long
   as the minor, and its centre. */
type ellipse is plane_figure {
    { a: distance, b: distance, ctr: point },
    constraint a >= b,
};

/* A polygon, by its vertices, numbered from 1, each at a point of its own:
   a component can be a relation, and a constraint says what its tuples
   are. */
type polygon is plane_figure {
    { vertices: relation { v_no: integer, vertex: point } },
    constraint count{r: vertices{v_no}} = count{r: vertices},
    constraint count{r: vertices{vertex}} = count{r: vertices},
    constraint is_empty{r: vertices where v_no < 1 or v_no > count{r: vertices}},
};

/* The point on the other side of the origin (TTM's REFLECT). */
operator reflect{p: point}: point [
    point{x: -p.x, y: -p.y}
];

var pt := point{x: 5e0, y: 2.5e0};
var reflected := reflect{p: pt};

/* A point's polar coordinates, the reflected point's half a turn from
   the point's, and a point selected by them: π/2 is no approximate
   number, so its cosine isn't 0, and the point is only nearly on the y
   axis. */
var polar := tuple { r: reflected.r, theta: reflected.theta };
var apart := dist{p1: pt, p2: reflected};
var north := point{r: distance{m: 3e0}, theta: angle{rho: pi{} / 2e0}};
var origin := point{r: distance{m: 0e0}, theta: angle{rho: 1e0}};

/* `THE_R ( P ) := …`: a component of the polar representation changed,
   the point selected in it, at the same angle, twice as far from the
   origin. */
var farther := [
    var q := pt;
    update q { r := distance{m: 2e0 * r.m} };
    q
];

/* `THE_R ( P ) := …, THE_THETA ( P ) := …`, a multiple assignment (RM
   Prescription 21): updates of the components of one representation, in
   an `assign` block, each computed from the point as it was, combine into
   one selection in it, here twice as far from the origin and a quarter
   turn further round. */
var turned := [
    var q := pt;
    assign {
        update q { r := distance{m: 2e0 * r.m} };
        update q { theta := angle{rho: theta.rho + pi{} / 2e0} };
    };
    q
];

/* `THE_X ( P ) := 2.0`: a component changed with `update`, and one of a
   value inside another, `THE_X ( THE_BEGIN ( LS ) ) := 6.5`. */
var moved := [
    var q := pt;
    update q { x := 2e0 };
    q
];
var segment := [
    var ls := lineseg{begin: pt, end: reflected};
    update ls { begin := begin replace { x := 6.5e0 } };
    ls
];

/* An ellipse's semiaxes changed together, by one `update`, as TTM
   recommends: one at a time, a major semiaxis of 3 would be shorter than
   the minor one of 4 in between, which no ellipse has. */
var squashed := [
    var e := ellipse{a: distance{m: 5e0}, b: distance{m: 4e0}, ctr: pt};
    update e { a := distance{m: 3e0}, b := distance{m: 2e0} };
    e
];

var triangle := polygon{vertices: relation {
    { v_no: 1, vertex: point{x: 0e0, y: 0e0} },
    { v_no: 2, vertex: point{x: 4e0, y: 0e0} },
    { v_no: 3, vertex: point{x: 0e0, y: 3e0} },
}};
var corners := count{r: triangle.vertices};

/* Plane figures of both kinds in one relation: a value of a subtype is a
   value of its union type, which the attribute is of, the most specific
   type both are (IM Prescriptions 8 and 16). */
var figures := relation {
    { name: "pond", figure: squashed },
    { name: "plot", figure: triangle },
};

/* The ellipses among them, with their major semiaxes: `is` tests a value's
   type (IM Prescription 15), and in the rest of the condition, and in the
   result's heading, `figure` is an ellipse, so its components can be read
   in the `extend`. */
var ellipses := figures where figure is ellipse;
var majors := ellipses extend { major := figure.a }{name, major};

/* What a figure is, and its area: an operator of a union type's values,
   with no body, and a version for each kind of figure, which a call
   computes for its argument's own type (IM Prescription 17). A program
   that adds a kind of figure adds its versions, or is told to. A
   polygon's area is half the sum, around it, of each edge's cross
   product, by the shoelace formula. */
operator kind{figure: plane_figure}: text;

operator kind{figure: ellipse}: text [
    "ellipse"
];

operator kind{figure: polygon}: text [
    to_text{from: count{r: figure.vertices}} || "-gon"
];

operator area{figure: plane_figure}: approximate;

operator area{figure: ellipse}: approximate [
    pi{} * figure.a.m * figure.b.m
];

operator area{figure: polygon}: approximate [
    var n := count{r: figure.vertices};
    var edges := (figure.vertices extend { next := v_no mod n + 1 })
        join (figure.vertices rename {v_no as next, vertex as to});
    var twice := sum{r: edges, of: vertex.x * to.y - to.x * vertex.y};
    if twice < 0e0 then -twice / 2e0 else twice / 2e0
];

var sizes := figures extend { size := area{figure: figure} }{name, size};

/* The vertex nearest the origin, and the vertices' numbers in the points'
   order: the one at the origin, then the one 3 from it, on the y axis,
   then the one 4 from it, on the x axis. */
var nearest := min{r: triangle.vertices, of: vertex};
var outward := [
    var numbers: array integer;
    load numbers value from triangle.vertices order [asc vertex] remove {vertex};
    numbers
];

operator geometry{p: point, shape: polygon} [
    var opposite := reflect{p: p};
    call debug_value{v: opposite};
    call debug_value{v: tuple { r: opposite.r, theta: opposite.theta }};
    call debug_value{v: dist{p1: p, p2: opposite}};
    call debug_value{v: point{r: distance{m: 3e0}, theta: angle{rho: pi{} / 2e0}}};
    call debug_value{v: point{r: distance{m: 0e0}, theta: angle{rho: 1e0}}};
    var doubled := p;
    update doubled { r := distance{m: 2e0 * r.m} };
    call debug_value{v: doubled};
    var round := p;
    assign {
        update round { r := distance{m: 2e0 * r.m} };
        update round { theta := angle{rho: theta.rho + pi{} / 2e0} };
    };
    call debug_value{v: round};
    var q := p;
    update q { x := 2e0 };
    call debug_value{v: q};
    var ls := lineseg{begin: p, end: opposite};
    update ls { begin := begin replace { x := 6.5e0 } };
    call debug_value{v: ls};
    var e := ellipse{a: distance{m: 5e0}, b: distance{m: 4e0}, ctr: p};
    update e { a := distance{m: 3e0}, b := distance{m: 2e0} };
    call debug_value{v: e};
    call debug_value{v: count{r: shape.vertices}};
    call debug_value{v: min{r: shape.vertices, of: vertex}};
    var numbers: array integer;
    load numbers value from shape.vertices order [asc vertex] remove {vertex};
    call debug_value{v: numbers};
    var figures := relation {
        { name: "pond", figure: e },
        { name: "plot", figure: shape },
    };
    call debug_table{r: figures};
    call debug_table{
        r: (figures where figure is ellipse) extend { major := figure.a }{name, major},
    };
    call debug_value{v: kind{figure: e}};
    call debug_value{v: kind{figure: shape}};
    call debug_table{r: figures extend { size := area{figure: figure} }{name, size}};
];

operator main{} [
    call debug_value{v: reflected};
    call debug_value{v: polar};
    call debug_value{v: apart};
    call debug_value{v: north};
    call debug_value{v: origin};
    call debug_value{v: farther};
    call debug_value{v: turned};
    call debug_value{v: moved};
    call debug_value{v: segment};
    call debug_value{v: squashed};
    call debug_value{v: corners};
    call debug_value{v: nearest};
    call debug_value{v: outward};
    call debug_table{r: figures};
    call debug_table{r: majors};
    call debug_value{v: kind{figure: squashed}};
    call debug_value{v: kind{figure: triangle}};
    call debug_table{r: sizes};

    call geometry{p: pt, shape: triangle};
];

/* A program of two units: this file, its main, and `lakes.depths`, the
   file `lakes/depths.trendy` beside it, named by its path from here. A
   `uses` brings what that unit's interface declares, its type, its
   heading and its operators, each by its name; what its implementation
   keeps, such as the variable the lakes are recorded in, no other unit
   sees. */
uses { lakes.depths };

operator main{} [
    call record{name: "Baikal", native: "Байкал", depth: 1642};
    call record{name: "Tanganyika", native: "Tanganyika", depth: 1470};
    call record{name: "Titicaca", native: "Titiqaqa", depth: 281};
    var lakes: relation lake;
    call recorded{out lakes: lakes};
    call debug_value{v: count{r: lakes}};
    call debug_value{v: (deepest{lakes: lakes}){name, native}};
    call debug_value{v: (lakes where depth < metres{cm: 50000}){name}};
];

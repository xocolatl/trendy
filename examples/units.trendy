/* A program of two units: this file, its main, and `lakes.depths`, the
   file `lakes/depths.trendy` beside it, named by its path from here. A
   `uses` brings what that unit's interface declares, its type, its
   heading and its operators, each by its name; what its implementation
   keeps, such as the variable the lakes are recorded in, no other unit
   sees. */
uses { lakes.depths };

/* This unit's own `lake`, which hides the one `lakes.depths` declares,
   here: a unit never qualifies its own names, and names another unit's
   that it hides qualified by that unit's name, `lakes.depths::lake`. */
heading lake := { name: text, shallow: boolean };

/* This unit's own `deepest`, which hides `lakes.depths`'s here too, and
   calls it qualified: the name of the deepest of `lakes`. */
operator deepest{lakes: relation lakes.depths::lake}: text [
    value from (lakes.depths::deepest{lakes: lakes}){name}
];

operator main{} [
    call record{name: "Baikal", native: "Байкал", depth: 1642};
    call record{name: "Tanganyika", native: "Tanganyika", depth: 1470};
    call record{name: "Titicaca", native: "Titiqaqa", depth: 281};
    var lakes: relation lakes.depths::lake;
    call recorded{out lakes: lakes};
    call debug_value{v: count{r: lakes}};
    call debug_value{v: deepest{lakes: lakes}};
    var marked := lakes extend { shallow := depth < metres{cm: 50000} };
    var shallow: relation lake := marked{name, shallow};
    call debug_value{v: shallow where shallow};
];

type position { { latitude: approximate, longitude: approximate } };

var folded := 1 < 2 and "a" < "b" and false < true;
var one_zero := -0e0 = 0e0;
var ada := tuple { name: "Ada", born: 1815 };
var people := relation {
    { name: "Ada", born: 1815 },
    { name: "Edgar", born: 1923 },
};
var folded_tuples := ada = tuple { born: 1815, name: "Ada" };
var folded_positions := position{latitude: 1.5e0, longitude: 2.5e0}
    <> position{latitude: 2.5e0, longitude: 1.5e0};

operator booleans{a: boolean, b: boolean} [
    call debug_value{v: a = b};
    call debug_value{v: a <> b};
    call debug_value{v: a < b};
    call debug_value{v: a <= b};
    call debug_value{v: a > b};
    call debug_value{v: a >= b};
];

operator integers{a: integer, b: integer} [
    call debug_value{v: a = b};
    call debug_value{v: a <> b};
    call debug_value{v: a < b};
    call debug_value{v: a <= b};
    call debug_value{v: a > b};
    call debug_value{v: a >= b};
];

operator approximate_numbers{a: approximate, b: approximate} [
    call debug_value{v: a = b};
    call debug_value{v: a <> b};
    call debug_value{v: a < b};
    call debug_value{v: a <= b};
    call debug_value{v: a > b};
    call debug_value{v: a >= b};
];

operator texts{a: text, b: text} [
    call debug_value{v: a = b};
    call debug_value{v: a <> b};
    call debug_value{v: a < b};
    call debug_value{v: a <= b};
    call debug_value{v: a > b};
    call debug_value{v: a >= b};
];

operator tuples{a: tuple { name: text, born: integer }, b: tuple { name: text, born: integer }} [
    call debug_value{v: a = b};
    call debug_value{v: a <> b};
];

operator relations{
    a: relation { name: text, born: integer },
    b: relation { name: text, born: integer },
} [
    call debug_value{v: a = b};
    call debug_value{v: a <> b};
];

operator nested{
    a: tuple { r: relation { x: approximate } },
    b: tuple { r: relation { x: approximate } },
} [
    call debug_value{v: a = b};
    call debug_value{v: a <> b};
];

operator positions{a: position, b: position} [
    call debug_value{v: a = b};
    call debug_value{v: a <> b};
];

operator main{} [
    call debug_value{v: folded};
    call debug_value{v: one_zero};
    call debug_value{v: folded_tuples};
    call debug_value{v: folded_positions};
    call booleans{a: false, b: true};
    call booleans{a: true, b: true};
    call integers{a: -2, b: 1};
    call integers{a: 7, b: 7};
    call approximate_numbers{a: -0e0, b: 0e0};
    call approximate_numbers{a: 2.5e0, b: -1e300};
    call texts{a: "Z", b: "a"};
    call texts{a: "é", b: "😀"};
    call texts{a: "ab", b: "a"};
    call texts{a: "", b: ""};
    call tuples{a: ada, b: tuple { name: "Ada", born: 1815 }};
    call tuples{a: ada, b: tuple { name: "Ada", born: 1816 }};
    call tuples{a: ada, b: tuple { name: "Adb", born: 1815 }};
    call relations{
        a: people,
        b: relation {
            { name: "Edgar", born: 1923 },
            { name: "Ada", born: 1815 },
        },
    };
    call relations{a: people, b: relation { { name: "Ada", born: 1815 } }};
    call relations{a: people, b: relation {}};
    call relations{a: relation {}, b: relation {}};
    call nested{a: tuple { r: relation { { x: 0e0 } } }, b: tuple { r: relation { { x: -0e0 } } }};
    call nested{
        a: tuple { r: relation {
            { x: 1.5e0 },
            { x: 2.5e0 },
        } },
        b: tuple { r: relation {
            { x: 2.5e0 },
            { x: 1.5e0 },
        } },
    };
    call positions{
        a: position{latitude: 0e0, longitude: 1.5e0},
        b: position{latitude: -0e0, longitude: 1.5e0},
    };
    call positions{
        a: position{latitude: 1.5e0, longitude: 2.5e0},
        b: position{latitude: 2.5e0, longitude: 1.5e0},
    };
];

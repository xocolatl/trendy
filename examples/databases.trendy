/* A library's database: its books, each with its title in its own
   language too, and its members, a database's relvars, which outlive any
   program that uses them (TTM RM Prescription 16). Each is declared on its
   own, with the database's name before its own. The database's own units,
   this one, which declares it, and those under its directory,
   `databases/`, add to it, as `databases/loans.trendy` adds what is on
   loan, which no unit uses, but every program that uses the database has,
   with its constraints. Nothing reads a database yet: this is its
   definition, which the catalog records. */
interface

database library;

var library.books: relation { isbn: text, title: text, native: text } key { isbn };
var library.members: relation { member: integer, name: text } key { member };

implementation

operator main{} [];

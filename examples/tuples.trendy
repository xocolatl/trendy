var x: tuple { a: tuple { b: boolean }, c: text };
var q := tuple { x: 1e0, y: 2e0 };
var e: tuple {};
var addr := tuple {
    street: "1 Rue de Rivoli",
    city: "Paris",
    country: "France",
    postal_code: "75001",
};

/* Tuple operators, to design and then implement one at a time. Each comment
   is one operator: what The Third Manifesto asks for (RM Prescription 6
   unless noted), Tutorial D's spelling, and a proposed trendy spelling to
   workshop, with code that uses it.

   Underneath, the operators are those of Algebra A (The Third Manifesto,
   Appendix A): remove, rename and compose, with and, or and not for
   relations. The others are defined in terms of them; project, for one,
   is remove of the attributes not named.

   In extend and replace, the tuple's own attributes are in scope by name,
   and hide any variable or parameter of the same name. To use one of
   those, rename it first. */

/* Projection, and its complement, remove (Algebra A's REMOVE): the tuple
   with only the attributes named, or without them. Implemented: each
   result below is printed twice, folded when compiling and computed when
   running. */
var located := addr{country, postal_code};
var unlocated := addr remove {city, street};
var nothing := addr{};

operator project_addr{a: tuple { street: text, city: text, country: text, postal_code: text }} [
    call debug_value{v: a{country, postal_code}};
    call debug_value{v: a remove {city, street}};
    call debug_value{v: a{}};
    call debug_value{v: x remove {c}{a}};
];

/* Renaming attributes (Algebra A's RENAME), each `old as new`, all at
   once, so two attributes can swap names. Implemented, and printed twice
   like the projections. */
var moved := addr rename {postal_code as code};
var swapped := q rename {x as y, y as x};

operator rename_addr{
    a: tuple { street: text, city: text, country: text, postal_code: text },
    p: tuple { x: approximate, y: approximate },
} [
    call debug_value{v: a rename {postal_code as code}};
    call debug_value{v: p rename {x as y, y as x}};
];

/* Building tuples from run-time values (RM Prescription 9): attribute
   values can be any expression, not only constants. Implemented, and
   printed twice like the projections. */
var built := tuple { street: "Невский проспект!", number: tuple { n: 13 } };

operator build_addr{street: text, n: integer} [
    call debug_value{v: tuple { street: street || "!", number: tuple { n: n + 1 } }};
];

/* Attribute extraction (RM Prescription 6, item b): `t.a` is the value of
   the attribute `a`, with dot notation as Date and Darwen suggest (ch. 6),
   reaching into nested tuples too. Implemented, and printed twice like the
   projections. */
var code := addr.postal_code;
var flag := x.a.b;
var sum := q.x + q.y;

operator extract{
    a: tuple { street: text, city: text, country: text, postal_code: text },
    t: tuple { a: tuple { b: boolean }, c: text },
    p: tuple { x: approximate, y: approximate },
} [
    call debug_value{v: a.postal_code};
    call debug_value{v: t.a.b};
    call debug_value{v: p.x + p.y};
];

/* Extension: the tuple with attributes added, each `name := value`, where
   the value is computed from the tuple's own attributes, which are in scope
   by name and hide variables and parameters of the same name. Tutorial D:
   EXTEND ADDR ADD ( 2 AS FLOOR ). Implemented, and printed twice like the
   projections. */
var floored := addr extend { floor := 2, line := street || ", " || city };
var summed := q extend { total := x + y, outer := tuple { inner: x } };

operator extend_addr{
    a: tuple { street: text, city: text, country: text, postal_code: text },
    p: tuple { x: approximate, y: approximate },
} [
    call debug_value{v: a extend { floor := 2, line := street || ", " || city }};
    call debug_value{v: p extend { total := x + y, outer := tuple { inner: x } }};
];

/* Substitution: the tuple with attributes it has given new values of the
   same types, each `name := value`, computed from the old ones, all at
   once, so `y := x` takes the old `x` (Tutorial D, beyond RM Prescription
   6; shorthand for extend, remove and rename). Tutorial D: UPDATE ADDR (
   POSTAL_CODE := '75002' ). Implemented, and printed twice like the
   projections. */
var recoded := addr replace { postal_code := "75002" };
var flipped := q replace { x := y * 2e0, y := x };

operator replace_addr{
    a: tuple { street: text, city: text, country: text, postal_code: text },
    p: tuple { x: approximate, y: approximate },
} [
    call debug_value{v: a replace { postal_code := "75002" }};
    call debug_value{v: p replace { x := y * 2e0, y := x }};
];

/* Wrapping: gather attributes into a tuple-valued attribute, each
   `name := {attributes}` (RM Prescription 6, item c: "nesting"). Several
   wrappings are simultaneous; to wrap one into another, chain `wrap`s. A
   new name can be one it gathers. Unwrapping replaces tuple-valued
   attributes with their attributes ("unnesting"), and undoes it.
   Tutorial D: ADDR WRAP ( { STREET, CITY } AS PLACE ), and
   X UNWRAP ( A ). Implemented, and printed twice like the projections. */
var placed := addr wrap { place := {street, city} };
var nested := addr wrap { place := {street, city} } wrap { location := {place, country} };
var unplaced := placed unwrap {place};

operator wrap_addr{a: tuple { street: text, city: text, country: text, postal_code: text }} [
    call debug_value{v: a wrap { place := {street, city} }};
    call debug_value{v: a wrap { place := {street, city} } wrap { location := {place, country} }};
    call debug_value{v: a wrap { place := {street, city} } unwrap {place}};
];

/* Joins: `join` gives a tuple both tuples' attributes, which must agree
   on those they have in common; `times`, of tuples with none in common,
   never fails; `compose` joins, then drops the common ones. The same
   operators as for relations (see relations.trendy), with the same rules
   for common attributes, and lists: join{t1, t2, t3}. Tuples that
   disagree have no join, which is an error: when compiling if both are
   known then, and otherwise when running (R0004).
   Tutorial D: ADDR UNION TUPLE { NAME 'Ada' } (tuple union, also called
   tuple join), T1 COMPOSE T2. Implemented, and printed twice like the
   projections. */
var districted := addr join tuple { postal_code: "75001", district: "1st" };
var district := addr compose tuple { postal_code: "75001", district: "1st" };
var dated := addr times tuple { year: 2024 };
var regioned := join{
    addr,
    tuple { postal_code: "75001", district: "1st" },
    tuple { city: "Paris", region: "Île-de-France" },
};

operator join_addr{
    a: tuple { street: text, city: text, country: text, postal_code: text },
    d: tuple { postal_code: text, district: text },
} [
    call debug_value{v: a join d};
    call debug_value{v: a compose d};
    call debug_value{v: a times tuple { year: 2024 }};
    call debug_value{v: join{a, d, tuple { city: "Paris", region: "Île-de-France" }}};
];

/* Tuple extraction: `tuple from r` is the only tuple of a relation, and
   `value from r` the only value of it, of a relation of one attribute;
   with no tuples or several, it is an error, when compiling if the
   relation is known then, and otherwise when running (R0005). It takes the
   rest of a relation's expression, `where` included, so
   `tuple from r where p` is of `r where p`; a projection after the `where`
   needs parentheses (RM Prescription 7's relation operators). `value` and
   `from` are names elsewhere.
   Tutorial D: TUPLE FROM R. Implemented, and printed twice like the
   projections. */
var cities := relation {
    { city: "Paris", country: "France" },
    { city: "Kumasi", country: "Ghana" },
};
var paris := tuple from cities where city = "Paris";
var country := value from (cities where city = "Paris"){country};

operator take_city{c: relation { city: text, country: text }} [
    call debug_value{v: tuple from c where city = "Paris"};
    call debug_value{v: value from (c where city = "Paris"){country}};
];

operator main{} [
    call debug_value{v: located};
    call debug_value{v: unlocated};
    call debug_value{v: nothing};
    call debug_value{v: x{a}};
    call debug_value{v: moved};
    call debug_value{v: swapped};
    call debug_value{v: built};
    call debug_value{v: code};
    call debug_value{v: flag};
    call debug_value{v: sum};
    call debug_value{v: floored};
    call debug_value{v: summed};
    call debug_value{v: recoded};
    call debug_value{v: flipped};
    call debug_value{v: placed};
    call debug_value{v: nested};
    call debug_value{v: unplaced};
    call debug_value{v: districted};
    call debug_value{v: district};
    call debug_value{v: dated};
    call debug_value{v: regioned};
    call debug_value{v: paris};
    call debug_value{v: country};

    call project_addr{a: addr};

    call rename_addr{a: addr, p: q};

    call build_addr{street: "Невский проспект", n: 12};

    call extract{a: addr, t: x, p: q};

    call extend_addr{a: addr, p: q};

    call replace_addr{a: addr, p: q};

    call wrap_addr{a: addr};

    call join_addr{a: addr, d: tuple { postal_code: "75001", district: "1st" }};

    call take_city{c: cities};
];

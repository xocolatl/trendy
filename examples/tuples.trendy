var x: tuple { a: tuple { b: boolean }, c: text };
var q := tuple { x: 1.0, y: 2.0 };
var e: tuple {};
var addr := tuple {
    street: "1 Rue de Rivoli",
    city: "Paris",
    country: "France",
    postal_code: "75001"
};

/* Tuple operators, to design and then implement one at a time. Each comment
   is one operator: what The Third Manifesto asks for (RM Prescription 6
   unless noted), Tutorial D's spelling, and a proposed trendy spelling to
   workshop, with code that uses it.

   Underneath, the operators are those of Algebra A (The Third Manifesto,
   Appendix A): remove, rename and compose, with and, or and not for
   relations. The others are defined in terms of them; project, for one,
   is remove of the attributes not named.

   In extend and update, the tuple's own attributes are in scope by name,
   and hide any variable or parameter of the same name. To use one of
   those, rename it first. */

/* Renaming by prefix, the rest of Algebra A's RENAME (see the renaming
   below, which is implemented).
   Tutorial D: ADDR RENAME ( PREFIX 'ST' AS 'G' )
   Proposed: a `prefix` renaming, written like the others.

   call debug_value{v: addr rename {prefix "st" as "g"}};
*/

/* Extension: the tuple with attributes added, computed from its own.
   Tutorial D: EXTEND ADDR ADD ( 2 AS FLOOR )
   Proposed: an `extend` operator with attribute values, in which the
   tuple's own attributes are in scope by name.

   call debug_value{v: addr extend { floor: 2 }};
   call debug_value{v: q extend { sum: x + y }};
*/

/* Join, also called tuple union: the union of two tuples' attributes. Any
   attribute both have must have the same value in both.
   Tutorial D: ADDR UNION TUPLE { NAME 'Ada' }, and n-adic
   UNION { T1, T2, T3 }
   Proposed: a `join` operator.

   call debug_value{v: addr join tuple { name: "Ada" }};
*/

/* Compose: join, then drop the attributes the operands have in common
   (Algebra A's COMPOSE; Tutorial D, beyond RM Prescription 6).
   Tutorial D: T1 COMPOSE T2
   Proposed: a `compose` operator.

   call debug_value{v: addr compose tuple { postal_code: "75001", district: "1st" }};
*/

/* Wrap: gather attributes into one tuple-valued attribute (RM Prescription
   6, item c: "nesting").
   Tutorial D: ADDR WRAP ( { STREET, CITY } AS PLACE )
   Decided: a `wrap` operator, with the names it gathers and the new
   attribute's name, written with `as` like a renaming.

   call debug_value{v: addr wrap {{street, city} as place}};
*/

/* Unwrap: replace a tuple-valued attribute with its attributes (RM
   Prescription 6, item c: "unnesting").
   Tutorial D: X UNWRAP ( A )
   Proposed: an `unwrap` operator, with the names to unwrap.

   call debug_value{v: x unwrap { a }};
*/

/* Substitute: the tuple with some attributes replaced, computed from its
   own (Tutorial D, beyond RM Prescription 6; shorthand for extend, project
   and rename).
   Tutorial D: UPDATE ADDR ( POSTAL_CODE := '75002' )
   Proposed: an `update` operator with attribute values, in which the
   tuple's own attributes are in scope by name.

   call debug_value{v: addr update { postal_code: "75002" }};
   call debug_value{v: q update { x: x * 2.0 }};
*/

/* Tuple extraction: the one tuple of a relation with exactly one, else a
   run-time error (RM Prescription 7's relation operators).
   Tutorial D: TUPLE FROM R
   Proposed: a `tuple from` prefix, as in Tutorial D.

   call debug_value{v: tuple from relation { { name: "Ada" } }};
*/

/* Assignment and update (RM Prescription 21), once variables can be
   assigned at all.
   Tutorial D: ADDR := TUPLE { ... }, and UPDATE ADDR ( POSTAL_CODE := '75002' )
   Proposed: an assignment statement, and `update` as a statement.

   addr := addr update { postal_code: "75002" };
   update addr { postal_code: "75002" };
*/

/* Projection, and its complement, remove (Algebra A's REMOVE): the tuple
   with only the attributes named, or without them. Implemented: each
   result below is printed twice, folded when compiling and computed when
   running. */
var located := addr{country, postal_code};
var unlocated := addr remove {city, street};
var nothing := addr{};

operator project_addr{a: tuple { street: text, city: text, country: text, postal_code: text }} [
    call debug_value{v: a{country, postal_code}};
    call debug_value{v: a remove {city, street}};
    call debug_value{v: a{}};
    call debug_value{v: x remove {c}{a}};
];

/* Renaming attributes (Algebra A's RENAME), each `old as new`, all at
   once, so two attributes can swap names. Implemented, and printed twice
   like the projections. */
var moved := addr rename {postal_code as code};
var swapped := q rename {x as y, y as x};

operator rename_addr{
    a: tuple { street: text, city: text, country: text, postal_code: text },
    p: tuple { x: rational, y: rational }
} [
    call debug_value{v: a rename {postal_code as code}};
    call debug_value{v: p rename {x as y, y as x}};
];

/* Building tuples from run-time values (RM Prescription 9): attribute
   values can be any expression, not only constants. Implemented, and
   printed twice like the projections. */
var built := tuple { street: "Невский проспект!", number: tuple { n: 13 } };

operator build_addr{street: text, n: integer} [
    call debug_value{v: tuple { street: street || "!", number: tuple { n: n + 1 } }};
];

/* Attribute extraction (RM Prescription 6, item b): `t.a` is the value of
   the attribute `a`, with dot notation as Date and Darwen suggest (ch. 6),
   reaching into nested tuples too. Implemented, and printed twice like the
   projections. */
var code := addr.postal_code;
var flag := x.a.b;
var sum := q.x + q.y;

operator extract{
    a: tuple { street: text, city: text, country: text, postal_code: text },
    t: tuple { a: tuple { b: boolean }, c: text },
    p: tuple { x: rational, y: rational }
} [
    call debug_value{v: a.postal_code};
    call debug_value{v: t.a.b};
    call debug_value{v: p.x + p.y};
];

operator main{} [
    call debug_value{v: located};
    call debug_value{v: unlocated};
    call debug_value{v: nothing};
    call debug_value{v: x{a}};
    call debug_value{v: moved};
    call debug_value{v: swapped};
    call debug_value{v: built};
    call debug_value{v: code};
    call debug_value{v: flag};
    call debug_value{v: sum};

    call project_addr{a: addr};

    call rename_addr{a: addr, p: q};

    call build_addr{street: "Невский проспект", n: 12};

    call extract{a: addr, t: x, p: q};
];

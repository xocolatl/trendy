var empty: relation { a: boolean, b: integer };
var r := relation { a: integer } { { a: 1 } };
/* Keys (RM Prescription 15): no two tuples have the same values for a
   key's attributes. A variable can have several, and one without any has
   its whole heading as its key. Implemented, and checked when compiling. */
var people := relation {
    tuple { name: "Ada", born: 1815 },
    { name: "Edgar", born: 1923 },
}
key { name };

var nested: tuple { name: text, friends: relation { name: text } };
var teams := relation {
    {
        team: "core",
        members: relation {
            { name: "Ada" },
            { name: "Edgar" }
        }
    },
    { team: "docs", members: relation { name: text } {} },
}
key { team };

var cities := relation {
    { name: "Ada", city: "London" },
    { name: "Edgar", city: "Portland" },
    { name: "Wangari", city: "Nyeri" },
}
key { name };

/* Relational operators, to design and then implement one at a time, each
   with its tuple analog where there is one (see tuples.trendy). Each
   comment is one operator: what The Third Manifesto asks for (RM
   Prescription 18 unless noted), Tutorial D's spelling, and a proposed
   trendy spelling to workshop, with code that uses it.

   Underneath, the operators are those of Algebra A (The Third Manifesto,
   Appendix A): and, or and not, which generalize join, union and
   complement, with remove, rename and compose. The others are defined in
   terms of them. Not, the complement, can be infinite, so it is only used
   underneath, never written.

   In where, extend and replace, the attributes of the tuple at hand are in
   scope by name, and hide any variable or parameter of the same name. To
   use one of those, rename it first. So are its image relations, below. */

/* The empty relations of degree zero (RM Prescription 10): table_dee, with
   one tuple, which is true, and table_dum, with none, which is false.
   Tutorial D: TABLE_DEE and TABLE_DUM
   Proposed: they're relation {} {{}} and relation {} {}, so no keywords
   are needed; perhaps built-in constants in the prelude, named dee and dum.

   call debug_value{v: relation {} { {} }};
*/

/* Membership: whether a tuple is in a relation (RM Prescription 22).
   Tutorial D: t ∈ r, and t ∉ r
   Proposed: an `in` operator. Since `not` binds tightest, not being in is
   `not (t in r)`.

   call debug_value{v: tuple { name: "Ada", born: 1815 } in people};
*/

/* Comparisons (RM Prescription 22): = and <> as now, and subset and
   superset, proper or not.
   Tutorial D: ⊆, ⊂, ⊇ and ⊃
   Proposed: keywords, since relations have no order and `<=` would suggest
   one: `subset`, `superset`, and `proper subset`, `proper superset`.

   call debug_value{v: people{name} subset cities{name}};
*/

/* Disjoint union: union, where the operands must have no tuple in common,
   or the program fails.
   Tutorial D: R1 D_UNION R2, and D_UNION { R1, R2, R3 }
   Proposed: a `disjoint union` operator.

   call debug_value{v: people disjoint union relation { { name: "李白", born: 701 } }};
*/

/* Aggregates (RM Prescription 18 and OO Prescription 6): count, sum, avg,
   max, min, and, or, xor, exactly, union, disjoint union and intersect,
   of a relation, or of one of its attributes.
   Tutorial D: COUNT ( PEOPLE ), MAX ( PEOPLE, BORN )
   Proposed: read-only built-in operators, called like any operator, once
   read-only operators exist. The empty relation's sum is 0, while its max
   has no value, which is an error.

   call debug_value{v: count{r: people}};
   call debug_value{v: max{r: people{born}}};
*/

/* Aggregates per group: an extend of the groups, each with an aggregate
   of its image relation (see the image relations below), so trendy has
   no summarize. A group with no tuples is still there, with a count of 0,
   unlike with SQL's GROUP BY; and an aggregate is of the image relation's
   tuples, so equal values in different tuples all count.
   Tutorial D: EXTEND CITIES { CITY } : { N := COUNT ( !!PEOPLE ) }, from
   Date and Darwen's Database Explorations, replacing SUMMARIZE PER and BY;
   TTM's Appendix A expands SUMMARIZE into EXTEND the same way.
   Needs the aggregate operators above, so read-only operators.

   Per city, how many people live there: Nyeri has none, so its n is 0.
   call debug_value{v: cities{city} extend { n := count{r: !!(people join cities)} }};

   Who was born in the same year as someone else.
   call debug_value{v: people where count{r: !!(people rename {name as other})} > 1};
*/
/* Transitive closure, of a relation of degree two whose attributes have
   the same type (RM Very Strong Suggestion 6).
   Tutorial D: TCLOSE R

   call debug_value{v: tclose relation { { from: 1, to: 2 }, { from: 2, to: 3 } }};
*/

/* Assignment, and its shorthands (RM Prescription 21), once variables can
   be assigned at all.
   Tutorial D: R := ..., INSERT R ..., DELETE R WHERE ..., and
   UPDATE R WHERE ... ( A := ... )
   Proposed: statements.

   people := people union relation { { name: "李白", born: 701 } };
   insert people relation { { name: "李白", born: 701 } };
   delete people where born > 1900;
   update people where name = "Ada" { born: 1815 };
*/

/* Projection, and its complement, remove (Algebra A's REMOVE). The result
   has no duplicates, so it can have fewer tuples, and is in canonical
   order. Implemented: each result below is printed twice, folded when
   compiling and computed when running, and the two must agree. */
var births := relation {
    { name: "Ada", born: 1815, place: "London" },
    { name: "Ada", born: 1816, place: "London" },
    { name: "Édouard", born: 1815, place: "Paris" },
    { name: "Edgar", born: 1923, place: "Portland" },
}
key { name, born };

var signs := relation {
    { x: 2.5e0, n: 1 },
    { x: -0e0, n: 2 },
    { x: -1.5e0, n: 3 },
    { x: 0e0, n: 4 },
    { x: -1.5e0, n: 5 },
};
var names := births{name};
var places := births remove {born, name};
var by_year := births{born, place};
var xs := signs remove {n};
var members := teams remove {team};
var dee := births{};
var dum := empty{};

operator project_births{r: relation { name: text, born: integer, place: text }} [
    call debug_value{v: r{name}};
    call debug_value{v: r remove {born, name}};
    call debug_value{v: r{born, place}};
    call debug_value{v: r{}};
];

operator project_signs{r: relation { x: approximate, n: integer }} [
    call debug_value{v: r remove {n}};
];

operator project_teams{r: relation { team: text, members: relation { name: text } }} [
    call debug_value{v: r remove {team}};
];

operator project_empty{r: relation { a: boolean, b: integer }} [
    call debug_value{v: r{}};
];

/* Renaming attributes (Algebra A's RENAME), each `old as new`, all at
   once. Renaming can change the attributes' order, so the tuples are sorted
   again; printed twice like the projections. Tuple analog: rename. */
var aliases := births rename {name as alias};
var swapped := signs rename {x as n, n as x};

operator rename_births{r: relation { name: text, born: integer, place: text }} [
    call debug_value{v: r rename {name as alias}};
];

operator rename_signs{r: relation { x: approximate, n: integer }} [
    call debug_value{v: r rename {x as n, n as x}};
];

/* Building relations from run-time values (RM Prescription 10). Tuples
   that turn out equal become one, so the result can have fewer tuples than
   written. Tuple analog: building tuples from run-time values.
   Implemented, and printed twice like the projections. */
var added := relation {
    { name: "李白", born: 701 },
    { name: "Ada", born: 1815 }
};
var collapsed := relation { { x: 1 } };
var held := tuple {
    who: "core",
    members: relation {
        { name: "Ada" },
        { name: "李白" }
    }
};

operator build_people{name: text, born: integer} [
    call debug_value{v: relation {
        { name: name, born: born },
        { name: "Ada", born: 1815 }
    }};
];

operator build_duplicates{a: integer, b: integer} [
    call debug_value{v: relation {
        { x: a },
        { x: b },
        { x: 1 }
    }};
];

operator build_nested{team: text, member: text} [
    call debug_value{v: tuple {
        who: team,
        members: relation {
            { name: member },
            { name: "Ada" }
        }
    }};
];

/* Join, times and compose, each Algebra A's AND: the tuples made of one
   tuple of each operand that agree on their common attributes, by name.
   Join needs at least one attribute in common, and times none, so that one
   shared, or not, by mistake is caught; compose is join without the common
   attributes. Tutorial D: PEOPLE JOIN CITIES, TIMES and COMPOSE.
   Implemented, and printed twice like the projections. Tuple analog: join
   and compose (see tuples.trendy). */
var lived := people join cities;
var born_in := people compose cities;
var years := relation {
    { year: 2024 },
    { year: 2025 }
};
var every_year := cities{city} times years;
/* Of any number of relations: join{r, s, t} and times{r, s, t}, in
   braces, since join and times are associative and commutative, and so
   their operands can be in any order. join{} and times{} are table_dee,
   AND's identity. Every operand of a join must connect to the others
   through common attributes, and no two of times may share one. Tutorial
   D: JOIN { R1, R2, R3 } and TIMES { R1, R2, R3 }. Compose isn't
   associative, so its list is in brackets, since the order matters:
   compose[r, s, t] is (r compose s) compose t. */
var lived_born := join{people, cities, births{name, born}};
var grid := times{cities{city}, years, people{born}};
var countries := relation {
    { city: "London", country: "United Kingdom" },
    { city: "Nyeri", country: "Kenya" },
    { city: "Portland", country: "United States" },
};
var born_where := compose[people, cities, countries];

operator join_people{
    p: relation { name: text, born: integer },
    c: relation { name: text, city: text },
    y: relation { year: integer },
    k: relation { city: text, country: text },
} [
    call debug_value{v: p join c};
    call debug_value{v: p compose c};
    call debug_value{v: c{city} times y};
    call debug_value{v: join{p, c, p}};
    call debug_value{v: times{c{city}, y, p{born}}};
    call debug_value{v: compose[p, c, k]};
];

/* Extension: each tuple with attributes added, each `name := value`,
   computed from the tuple's own attributes, which are in scope by name
   and hide variables and parameters of the same name. The values are
   computed for each tuple when the program runs, unless the relation is
   known when compiling. Tuple analog: extend. Tutorial D: EXTEND PEOPLE
   ADD ( 2024 - BORN AS AGE ). Implemented, and printed twice like the
   projections. */
var ages := people extend { age := 2024 - born, greeting := "Hi, " || name };
var rosters := teams extend { roster := members extend { role := "member" } };

operator extend_people{
    p: relation { name: text, born: integer },
    t: relation { team: text, members: relation { name: text } },
} [
    call debug_value{v: p extend { age := 2024 - born, greeting := "Hi, " || name }};
    call debug_value{v: t extend { roster := members extend { role := "member" } }};
];

/* Substitution: each tuple with attributes the relation has given new
   values of the same types, each `name := value`, computed from the old
   ones, all at once. Tuples that become equal are one: the result can
   have fewer. Tuple analog: replace. Tutorial D: UPDATE PEOPLE ( BORN :=
   BORN + 1 ), the read-only operator, which its version 2 folded into
   EXTEND. Implemented, and printed twice like the projections. */
var older := people replace { born := born + 1 };
var millennia := people{born} replace { born := born div 1000 };

operator replace_people{p: relation { name: text, born: integer }} [
    call debug_value{v: p replace { born := born + 1 }};
    call debug_value{v: p{born} replace { born := born div 1000 }};
];

/* Image relations: in the values of an extend or a replace, `!!r`
   is the image relation of the tuple at hand in r: the tuples of r that
   match it on their common attributes, without those attributes. It is
   r joined with the tuple at hand, projected on the attributes they have
   in common, which it must have, then without them. A tuple with no match
   has an empty image, so every group is there, unlike with SQL's GROUP BY.
   Tutorial D: !!R, from Date and Darwen's Database Explorations, which
   trendy writes the same way.
   Implemented, and printed twice like the projections. */
var natives := cities{city} extend { natives := !!(births rename {place as city}) };
var london := relation { { place: "London" } };
var london_only := births{name} extend { only_london := (!!births){place} = london };

operator image_births{
    b: relation { name: text, born: integer, place: text },
    c: relation { name: text, city: text },
} [
    call debug_value{v: c{city} extend { natives := !!(b rename {place as city}) }};
    call debug_value{v: b{name} extend { only_london := (!!b){place} = london }};
];

/* Grouping: gather attributes into a relation-valued attribute, one tuple
   for each value of the attributes no grouping gathers, each
   `name := {attributes}`. Several groupings are simultaneous, each of the
   same matching tuples, so their order doesn't matter, unlike Tutorial
   D's, which apply in turn. It is an extend of the kept attributes with
   image relations: `cities group { residents := {name} }` is
   `cities{city} extend { residents := !!cities }`.
   Tutorial D: CITIES GROUP ( { NAME } AS RESIDENTS ). Implemented, and
   printed twice like the projections. */
var by_place := births group { births := {name, born} };
var names_years := births group { names := {name}, years := {born} };
var rosters_by := teams extend { roster := members group { names := {name} } };

operator group_births{
    b: relation { name: text, born: integer, place: text },
    t: relation { team: text, members: relation { name: text } },
} [
    call debug_value{v: b group { births := {name, born} }};
    call debug_value{v: b group { names := {name}, years := {born} }};
    call debug_value{v: t extend { roster := members group { names := {name} } }};
];

/* Ungrouping: replace relation-valued attributes with their attributes,
   one tuple for each combination of a tuple of each, so a tuple whose
   relation is empty has none: below, the docs team, with no members. Of
   several attributes, the order doesn't matter, as the braces say. It
   undoes `group`: grouping then ungrouping gives the relation back.
   Tutorial D: TEAMS UNGROUP ( MEMBERS ). Implemented, and printed twice
   like the projections. */
var memberships := teams ungroup {members};
var regrouped := births group { births := {name, born} } ungroup {births};

operator ungroup_teams{
    t: relation { team: text, members: relation { name: text } },
    b: relation { name: text, born: integer, place: text },
} [
    call debug_value{v: t ungroup {members}};
    call debug_value{v: b group { births := {name, born} } ungroup {births}};
];

/* Wrapping and unwrapping, of each tuple (RM Prescription 7: nesting).
   Tuple analog: wrap and unwrap (see tuples.trendy).
   Tutorial D: PEOPLE WRAP ( { NAME, BORN } AS WHO ), PEOPLE UNWRAP ( WHO ).
   Implemented, and printed twice like the projections. */
var who_where := births wrap { who := {name, born} };
var unwrapped := births wrap { who := {name, born} } unwrap {who};

operator wrap_births{b: relation { name: text, born: integer, place: text }} [
    call debug_value{v: b wrap { who := {name, born} }};
    call debug_value{v: b wrap { who := {name, born} } unwrap {who}};
];

/* Restriction: the tuples for which a condition holds, a boolean in which
   the tuple's attributes are in scope by name. `where` binds loosest, so
   its condition is the rest of the expression, and what comes before it is
   restricted: below, the people who live where they were born. The tuples that pass
   stay in order, so none are sorted again.
   Tutorial D: PEOPLE WHERE BORN < 1900. Implemented, and printed twice like
   the projections. */
var early := births where born < 1900;
var early_not_ada := births where born < 1900 and name <> "Ada";
var at_home := births join cities where place = city;

operator restrict_births{
    b: relation { name: text, born: integer, place: text },
    c: relation { name: text, city: text },
} [
    call debug_value{v: b where born < 1900};
    call debug_value{v: b where born < 1900 and name <> "Ada"};
    call debug_value{v: b join c where place = city};
];

/* Semijoin and antijoin: the tuples of the first relation that have a
   match in the second, on their common attributes, or that have none. The
   result has the first's attributes only; below, with the common one
   removed, the births in a place that isn't one of `cities`' cities.
   Written like the joins, with their precedence and rules for common
   attributes.
   Tutorial D: PEOPLE MATCHING CITIES and PEOPLE NOT MATCHING CITIES.
   Implemented, and printed twice like the projections. */
var listed := people matching cities;
var born_elsewhere := (births rename {place as city} not matching cities{city}) remove {city};

operator matching_people{
    p: relation { name: text, born: integer },
    b: relation { name: text, born: integer, place: text },
    c: relation { name: text, city: text },
} [
    call debug_value{v: p matching c};
    call debug_value{v: (b rename {place as city} not matching c{city}) remove {city}};
];

/* Union, intersection and difference, of relations of one heading: the
   tuples of either, of both, and of the first but not the second. Union
   is Algebra A's OR, and binds more loosely than the joins, which are AND,
   as intersection and difference are. Of lists: `union{…}` and
   `intersect{…}`, in any order, and `minus[…]`, from the left.
   Tutorial D: R1 UNION R2, R1 INTERSECT R2, R1 MINUS R2, and
   UNION { R1, R2, R3 }. Implemented, and printed twice like the
   projections. */
var named := births{name} union cities{name};
var both := births{name} intersect cities{name};
var unlisted := births{name} minus cities{name};
var everyone := union{births{name}, cities{name}, people{name}};
var nobody_else := minus[births{name}, cities{name}, people{name}];

operator set_names{
    b: relation { name: text, born: integer, place: text },
    c: relation { name: text, city: text },
    p: relation { name: text, born: integer },
} [
    call debug_value{v: b{name} union c{name}};
    call debug_value{v: b{name} intersect c{name}};
    call debug_value{v: b{name} minus c{name}};
    call debug_value{v: union{b{name}, c{name}, p{name}}};
    call debug_value{v: minus[b{name}, c{name}, p{name}]};
];

operator main{} [
    call debug_value{v: names};
    call debug_value{v: places};
    call debug_value{v: by_year};
    call debug_value{v: dee};
    call debug_value{v: xs};
    call debug_value{v: members};
    call debug_value{v: dum};
    call debug_value{v: aliases};
    call debug_value{v: swapped};
    call debug_value{v: added};
    call debug_value{v: collapsed};
    call debug_value{v: held};
    call debug_value{v: lived};
    call debug_value{v: born_in};
    call debug_value{v: every_year};
    call debug_value{v: lived_born};
    call debug_value{v: grid};
    call debug_value{v: born_where};
    call debug_value{v: ages};
    call debug_value{v: rosters};
    call debug_value{v: older};
    call debug_value{v: millennia};
    call debug_value{v: natives};
    call debug_value{v: london_only};
    call debug_value{v: by_place};
    call debug_value{v: names_years};
    call debug_value{v: rosters_by};
    call debug_value{v: memberships};
    call debug_value{v: regrouped};
    call debug_value{v: who_where};
    call debug_value{v: unwrapped};
    call debug_value{v: early};
    call debug_value{v: early_not_ada};
    call debug_value{v: at_home};
    call debug_value{v: listed};
    call debug_value{v: born_elsewhere};
    call debug_value{v: named};
    call debug_value{v: both};
    call debug_value{v: unlisted};
    call debug_value{v: everyone};
    call debug_value{v: nobody_else};

    call project_births{r: births};
    call project_signs{r: signs};
    call project_teams{r: teams};
    call project_empty{r: empty};

    call rename_births{r: births};
    call rename_signs{r: signs};

    call build_people{name: "李白", born: 701};
    call build_duplicates{a: 1, b: 1};
    call build_nested{team: "core", member: "李白"};

    call join_people{p: people, c: cities, y: years, k: countries};

    call extend_people{p: people, t: teams};

    call replace_people{p: people};

    call image_births{b: births, c: cities};

    call group_births{b: births, t: teams};

    call ungroup_teams{t: teams, b: births};

    call wrap_births{b: births};

    call restrict_births{b: births, c: cities};

    call matching_people{p: people, b: births, c: cities};

    call set_names{b: births, c: cities, p: people};
];

/* Operators, read-only and update (TTM RM Prescription 3). A read-only
   operator has a result type, and its body ends with its value: its call
   is that value. An update operator returns nothing, and is invoked by `call`. A
   call is evaluated when compiling where it can be, and made when the
   program runs elsewhere. A parameter's type can be `any type`, and type
   parameters, declared with `types`, say that several types are one: each
   call gives them its arguments' types, which can be limited to a kind,
   as `ordered` or `numeric`. A `per` parameter's argument is evaluated
   for each tuple of a relation, as the prelude's `min` and `max` take
   `of`. main prints each result. A heading the operators share is
   declared once, with a name, which stands for it after `relation` and
   `tuple`. */
heading menu_item := { dish: text, country: text, price: integer };

var vat := 16;
var dishes := relation menu_item {
    { dish: "jollof rice", country: "Ghana", price: 1200 },
    { dish: "ramen", country: "Japan", price: 900 },
    { dish: "pozole", country: "Mexico", price: 750 },
}
key { dish };

/* A price in cents with VAT, rounded down. It reads `vat`, as it is when
   the operator is called. A read-only operator's local variables name
   parts of its value, which its body ends with. */
operator taxed{price: integer}: integer [
    var tax := price * vat div 100;
    price + tax
];

/* A relation, of the dishes whose price with VAT is under `limit`: the
   condition calls `taxed` for each. */
operator under{limit: integer}: relation menu_item [
    dishes where taxed{price: price} < limit
];

operator half{n: integer}: integer [
    n div 2
];

/* An update operator, invoked by `call`. `value` can be of any type. */
operator show{label: text, value: any type} [
    call debug_value{v: label};
    call debug_value{v: value};
];

/* A relation of two values, of any one type, `T`. */
operator both{a: T, b: T}: relation { v: T }
    types { T: any type }
[
    relation {
        tuple { v: a },
        tuple { v: b },
    }
];

/* Whether every tuple of `r` is one of `of`'s, whatever their heading, as
   long as it is one: relations are ordered by inclusion. */
operator within{r: R, of: R}: boolean
    types { R: any relation }
[
    r <= of
];

/* The values `of` takes for the tuples of `r`: `per r` evaluates its
   argument for each of them, with their attributes in scope, as in
   `where`. Inside, `of` is an attribute of `r`'s tuples. */
operator values{r: any relation, of: T per r}: relation { v: T }
    types { T: any type }
[
    r{of} rename {of as v}
];

/* The values of `of` below `limit`, of any type with an order: a kind,
   `ordered`, that the prelude declares, and its types declare. */
operator below{r: any relation, of: T per r, limit: T}: relation { v: T }
    types { T: any ordered }
[
    (r where of < limit){of} rename {of as v}
];

/* The least and the greatest value of `of`, of any ordered type, from the
   prelude's `min` and `max`, which fail for a relation with no tuples. */
operator range{r: any relation, of: T per r}: tuple { low: T, high: T }
    types { T: any ordered }
[
    tuple { low: min{r: r, of: of}, high: max{r: r, of: of} }
];

/* How many dishes are under `limit` with VAT, and the cheapest's price:
   `under` is computed once, for both. */
operator cheapest{limit: integer}: tuple { dishes: integer, lowest: integer } [
    var under := dishes where taxed{price: price} < limit;
    tuple { dishes: count{r: under}, lowest: min{r: under, of: taxed{price: price}} }
];

/* The mean price of `r`'s dishes with VAT, rounded down. An `if`
   computes only the branch it takes, so the mean of none is 0, and no
   division by zero. */
operator mean{r: relation menu_item}: integer [
    if is_empty{r: r} then 0 else sum{r: r, of: taxed{price: price}} div count{r: r}
];

/* A word for how many dishes `r` has: an `else if` chains another
   condition. */
operator how_many{r: relation menu_item}: text [
    if is_empty{r: r} then "none" else if count{r: r} = 1 then "one" else "several"
];

/* An order's cost, of any numeric type: `*` and `+` are what `numeric`,
   another kind the prelude declares, requires of its types. */
operator cost{price: T, quantity: T, delivery: T}: T
    types { T: any numeric }
[
    price * quantity + delivery
];

/* A label for a price: an `if`'s branches can be value blocks, which
   compute a value in steps, as a read-only operator's body does. */
operator band{price: integer}: text [
    if price < 1000 then [
        var under := 1000 - price;
        "under 1000 by " || to_text{from: under}
    ] else [
        var over := price - 1000;
        "over 1000 by " || to_text{from: over}
    ]
];

var special := "ramen";
var previous := "none";

/* A parameter keeps its value while the operator runs, even once the
   operator assigns the variable its argument came from. */
operator rotate{next: text} [
    assign {
        previous := special;
        special := next;
    };
    call debug_value{v: previous || " → " || special};
    call debug_value{v: next};
];

/* A `var` parameter takes a variable, which the operator can read and
   assign, and whose value is the parameter's when the operator ends (TTM
   RM Prescription 3); a call marks its argument `var` too, so that it
   shows what the call changes. A parameter without a mode is `const`: the
   operator only reads its argument's value. */
operator add_dish{var menu: relation menu_item, dish: text, country: text, price: integer} [
    insert menu relation menu_item { { dish: dish, country: country, price: price } };
];

/* `const` may be written, though it needn't be. */
operator discount{var price: integer, const percent: integer} [
    price := price - price * percent div 100;
];

/* A `var` parameter is passed on as a variable, which the operator
   called updates. */
operator discount_twice{var price: integer, percent: integer} [
    call discount{var price: price, percent: percent};
    call discount{var price: price, percent: percent};
];

var totals := dishes extend { total := taxed{price: price} } remove {price};
var affordable := under{limit: 1000}{dish};
var plural := if count{r: dishes} = 1 then "dish" else "dishes";

/* A value block in place: the spread between the dearest dish and the
   cheapest, with VAT. Its local variables are its own, and it is
   evaluated when compiling, as `vat` and `dishes` are known then. */
var spread := [
    var dearest := max{r: dishes, of: taxed{price: price}};
    var lowest := min{r: dishes, of: taxed{price: price}};
    dearest - lowest
];

operator main{} [
    call debug_table{r: totals};
    call debug_table{r: affordable};
    call show{label: "half of 1200", value: half{n: 1200}};
    call rotate{next: "spicy " || special};
    call rotate{next: previous};
    /* A call of an operator that reads a variable is made when the program
       runs, and reads the variable as it is then. */
    call debug_table{r: under{limit: 1100}{dish}};
    vat := 25;
    call debug_table{r: under{limit: 1100}{dish}};
    call debug_table{r: dishes extend { total := taxed{price: price} } remove {price}};
    /* A generic operator is compiled for each list of types it is called
       with when the program runs. */
    call show{label: "specials", value: both{a: special, b: previous}};
    call show{label: "affordable on the menu", value: within{r: affordable, of: dishes{dish}}};
    call show{label: "pairs", value: both{a: both{a: 1, b: 2}, b: both{a: 3, b: 4}}};
    call show{label: "with VAT", value: values{r: dishes, of: taxed{price: price}}};
    call show{label: "where from", value: values{r: dishes, of: dish || ", " || country}};
    call show{
        label: "how many under 1000",
        value: count{r: dishes where taxed{price: price} < 1000},
    };
    call show{label: "before p", value: below{r: dishes, of: dish, limit: "p"}};
    /* The prelude's `some` and `every`, written in trendy. */
    call show{label: "some under 1000", value: some{r: dishes, of: taxed{price: price} < 1000}};
    call show{label: "every under 1000", value: every{r: dishes, of: taxed{price: price} < 1000}};
    call show{label: "prices with VAT", value: range{r: dishes, of: taxed{price: price}}};
    call show{label: "names", value: range{r: dishes, of: dish}};
    /* `cost`, of integers and of approximate numbers. */
    call show{
        label: "two of each, delivered",
        value: values{r: dishes, of: cost{price: taxed{price: price}, quantity: 2, delivery: 300}},
    };
    call show{
        label: "one and a half ramen, delivered",
        value: cost{price: to_approximate{from: taxed{price: 900}}, quantity: 1.5e0, delivery: 3e2},
    };
    call show{label: "under 1200", value: cheapest{limit: 1200}};
    call show{label: "mean under 1000", value: mean{r: dishes where taxed{price: price} < 1000}};
    call show{label: "mean under 500", value: mean{r: dishes where taxed{price: price} < 500}};
    call show{
        label: "how many under 1200",
        value: how_many{r: dishes where taxed{price: price} < 1200},
    };
    /* Decided when compiling, as `dishes` is known then. */
    call show{label: "the menu's", value: plural};
    /* With `vat` at 25, known only when running. */
    call show{label: "spread", value: spread};
    call show{
        label: "spread now",
        value: [
            var dearest := max{r: dishes, of: taxed{price: price}};
            var lowest := min{r: dishes, of: taxed{price: price}};
            dearest - lowest
        ],
    };
    call show{label: "pozole", value: band{price: taxed{price: 750}}};
    /* The variables passed as `var` are what change: a local one, and
       one of the program's, whose key is checked once the call ends. */
    var specials := dishes where country = "Japan";
    call add_dish{var menu: specials, dish: "bobotie", country: "South Africa", price: 1100};
    call debug_table{r: specials};
    call add_dish{var menu: dishes, dish: "khachapuri", country: "Georgia", price: 950};
    call show{label: "dishes", value: count{r: dishes}};
    var price := 1000;
    call discount{var price: price, percent: 10};
    call show{label: "discounted", value: price};
    call discount_twice{var price: price, percent: 10};
    call show{label: "discounted twice more", value: price};
];

/* Operators, read-only and update (TTM RM Prescription 3). A read-only
   operator has a result type, and its body is one `return`: its call is a
   value. An update operator returns nothing, and is invoked by `call`. A
   call is evaluated when compiling where it can be, and made when the
   program runs elsewhere. A parameter's type can be `any type`, and type
   parameters, declared with `types`, say that several types are one: each
   call gives them its arguments' types. A `per` parameter's argument is
   evaluated for each tuple of a relation. main prints each result. */
var vat := 16;
var dishes := relation {
    { dish: "jollof rice", country: "Ghana", price: 1200 },
    { dish: "ramen", country: "Japan", price: 900 },
    { dish: "pozole", country: "Mexico", price: 750 },
}
key { dish };

/* A price in cents with VAT, rounded down. It reads `vat`, as it is when
   the operator is called. */
operator taxed{price: integer}: integer [
    return price + price * vat div 100;
];

/* A relation, of the dishes whose price with VAT is under `limit`: the
   condition calls `taxed` for each. */
operator under{limit: integer}: relation { dish: text, country: text, price: integer } [
    return dishes where taxed{price: price} < limit;
];

operator half{n: integer}: integer [
    return n div 2;
];

/* An update operator, invoked by `call`. `value` can be of any type. */
operator show{label: text, value: any type} [
    call debug_value{v: label};
    call debug_value{v: value};
];

/* A relation of two values, of any one type, `T`. */
operator both{a: T, b: T}: relation { v: T }
    types { T: any type }
[
    return relation {
        tuple { v: a },
        tuple { v: b }
    };
];

/* Whether every tuple of `r` is one of `of`'s, whatever their heading, as
   long as it is one: relations are ordered by inclusion. */
operator within{r: R, of: R}: boolean
    types { R: any relation }
[
    return r <= of;
];

/* The values `of` takes for the tuples of `r`: `per r` evaluates its
   argument for each of them, with their attributes in scope, as in
   `where`. Inside, `of` is an attribute of `r`'s tuples. */
operator values{r: any relation, of: T per r}: relation { v: T }
    types { T: any type }
[
    return r{of} rename {of as v};
];

var special := "ramen";
var previous := "none";

/* A parameter keeps its value while the operator runs, even once the
   operator assigns the variable its argument came from. */
operator rotate{next: text} [
    assign {
        previous := special;
        special := next;
    };
    call debug_value{v: previous || " → " || special};
    call debug_value{v: next};
];

var totals := dishes extend { total := taxed{price: price} } remove {price};
var affordable := under{limit: 1000}{dish};

operator main{} [
    call debug_value{v: totals};
    call debug_value{v: affordable};
    call show{label: "half of 1200", value: half{n: 1200}};
    call rotate{next: "spicy " || special};
    call rotate{next: previous};
    /* A call of an operator that reads a variable is made when the program
       runs, and reads the variable as it is then. */
    call debug_value{v: under{limit: 1100}{dish}};
    vat := 25;
    call debug_value{v: under{limit: 1100}{dish}};
    call debug_value{v: dishes extend { total := taxed{price: price} } remove {price}};
    /* A generic operator is compiled for each list of types it is called
       with when the program runs. */
    call show{label: "specials", value: both{a: special, b: previous}};
    call show{label: "affordable on the menu", value: within{r: affordable, of: dishes{dish}}};
    call show{label: "pairs", value: both{a: both{a: 1, b: 2}, b: both{a: 3, b: 4}}};
    call show{label: "with VAT", value: values{r: dishes, of: taxed{price: price}}};
    call show{label: "where from", value: values{r: dishes, of: dish || ", " || country}};
    call show{
        label: "how many under 1000",
        value: count{r: dishes where taxed{price: price} < 1000}
    };
    /* The prelude's `some` and `every`, written in trendy. */
    call show{label: "some under 1000", value: some{r: dishes, of: taxed{price: price} < 1000}};
    call show{label: "every under 1000", value: every{r: dishes, of: taxed{price: price} < 1000}};
];

var u := t or false;
var t := not f;
var f: boolean;
var chain := f implies f implies f;
/* Lists of any number of operands, in braces, as their order doesn't
   matter: whether every one is true, and whether an odd number are. */
var every_one := and{t, u, not f};
var odd := xor{t, u, f};
/* A boolean written in text: `true`, `t`, `yes`, `y` or `1`, or
   `false`, `f`, `no`, `n` or `0`, in any case. */
var parsed := parse_boolean{from: "Yes"};
/* Guards: of the operands of `and`, `or` and `implies`, those that can't
   fail are computed first, wherever they are written, and those that can
   only if they don't decide the result, in a list as in a chain. So
   nothing here divides by zero: when compiling, `steep`, and when
   running, `guards`. */
var points := relation {
    { x: 0, y: 5 },
    { x: 2, y: 6 },
    { x: 3, y: 1 },
};
var steep := points where y div x > 1 and x <> 0;

operator steep_at{x: integer, y: integer}: boolean [
    y div x > 1 and x <> 0
];

operator guards{r: relation { x: integer, y: integer }, zero: integer} [
    call debug_table{r: r where y div x > 1 and x <> zero};
    call debug_table{r: r where x <> zero implies y div x > 1};
    call debug_value{v: steep_at{x: zero, y: 5}};
    call debug_value{v: zero = 0 or 1 div zero = 1};
    call debug_value{v: and{5 div zero > 1, zero <> 0}};
];

/* The boolean `t` writes, read when the program runs. */
operator parse{t: text} [
    call debug_value{v: parse_boolean{from: t}};
];

operator table{a: boolean, b: boolean} [
    call debug_value{v: not a};
    call debug_value{v: a and b};
    call debug_value{v: a or b};
    call debug_value{v: a xor b};
    call debug_value{v: a implies b};
    call debug_value{v: xor{a, b, true}};
];

operator main{} [
    call debug_value{v: u};
    call debug_value{v: chain};
    call debug_value{v: every_one};
    call debug_value{v: odd};
    call table{a: false, b: false};
    call table{a: false, b: true};
    call table{a: true, b: false};
    call table{a: true, b: true};
    call debug_value{v: not (t and f) xor t};
    call debug_table{r: steep};
    call guards{r: points, zero: 0};
    call debug_value{v: parsed};
    call parse{t: "N"};
    call parse{t: "TRUE"};
];

/* The arguments the program is started with, but its path: `main` takes them as
   `arguments`, an array of text, in the order given. Each name given is welcomed in
   Swahili, and with none, everyone is. */
operator welcome{name: text}: text [
    "Karibu, " || name || "!"
];

operator main{arguments: array text} [
    if length{a: arguments} = 0 then [
        call debug_value{v: welcome{name: "kila mtu"}};
    ] else [
        for name in arguments loop [
            call debug_value{v: welcome{name}};
        ];
    ];
];

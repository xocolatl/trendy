var greeting := "hello" || ", " || "world";

var nothing := "" || "";

operator greet{name: text, punctuation: text} [
    call debug_value{v: "hello, " || name || punctuation};
    call debug_value{v: name || ""};
    call debug_value{v: tuple { t: "constant " || "parts fold" }};
];

/* A text file's lines, read when the program runs, into the variable
   for `lines`: an array, in the file's order, the first line its element
   1. A relative path is from the directory the program runs in: here,
   the repository's. Reading is an update operator's work, as two reads
   can differ. */
operator list_rivers{} [
    var rivers: array text;
    call load_text_file{path: "examples/rivers.txt", out lines: rivers};
    call debug_value{v: rivers};
    call debug_value{v: length{a: rivers}};
    for river in rivers loop [
        if river <> "" then [
            call debug_value{v: river};
        ];
    ];
];

/* A file that can't be read stops the program, unless the call names
   `out errors`: then it gives no lines, and its error, a value of one of
   the prelude's subtypes of `error`. */
operator list_missing{} [
    var rivers: array text;
    var errors: relation { error: error };
    call load_text_file{path: "examples/lakes.txt", out lines: rivers, out errors: errors};
    call debug_value{v: length{a: rivers}};
    call debug_value{v: errors};
];

/* A place on Earth, by its latitude and longitude, in degrees, as in
   types.trendy. */
type position {
    { latitude: approximate, longitude: approximate },
    constraint latitude >= -90e0 and latitude <= 90e0,
    constraint longitude > -180e0 and longitude <= 180e0,
};

/* An area, stored in square metres, and written in square kilometres
   too, as in types.trendy's temperatures. */
type area {
    { m2: approximate },
    { km2: approximate }
        to { m2 := km2 * 1e6 }
        from { km2 := m2 / 1e6 },
    constraint m2 >= 0e0,
    order [asc m2],
};

heading river := {
    name: text,
    length_km: integer,
    basin: area,
    reaches_ocean: boolean,
    mouth_at: position,
};

/* A CSV file's records, after its header, read when the program runs,
   into the variable for `rows`: an array of tuples, in the file's order,
   each attribute the field in the column `columns` gives it, counting
   from 1, read as its type. The file's columns have an order and no
   names, so the call names them, whatever the header calls them: its
   `km` is `length_km` here. Columns `columns` doesn't name, here
   `native_name` and `mouth`, are skipped. A value of a type of the
   program's own, here the position of a river's mouth, is read from its
   components' columns, a tuple of them, and selected from them, so a
   record whose components break the type's constraints stops the program,
   writing its line. The components can be those of any of its possible
   representations: a basin's area is read in square kilometres, as the
   file gives it, and stored in square metres. */
operator river_table{} [
    var rivers: array tuple river;
    call load_csv{
        path: "examples/rivers.csv",
        header: true,
        columns: tuple {
            name: 1,
            length_km: 3,
            basin: tuple { km2: 4 },
            reaches_ocean: 6,
            mouth_at: tuple { latitude: 7, longitude: 8 },
        },
        out rows: rivers,
    };
    call debug_value{v: rivers[1]};
    var table: relation river;
    load table from rivers;
    call debug_table{r: table};
];

operator main{} [
    call debug_value{v: greeting};
    call debug_value{v: nothing};
    call greet{name: "Ada", punctuation: "!"};
    call greet{name: "é\u{1F600}\"", punctuation: "\n"};
    call greet{name: "", punctuation: ""};
    call list_rivers{};
    call list_missing{};
    call river_table{};
];

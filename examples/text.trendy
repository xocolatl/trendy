/* Reading files is the work of `trendy.files`, a unit that comes with
   the compiler, which a unit uses as it does any other. */
uses { trendy.files };

var greeting := "hello" || ", " || "world";

var nothing := "" || "";

operator greet{name: text, punctuation: text} [
    call debug_value{v: "hello, " || name || punctuation};
    call debug_value{v: name || ""};
    call debug_value{v: tuple { t: "constant " || "parts fold" }};
];

/* A text is made of code points, values of `code_point`, which
   `to_code_points` gives in order: one for each Unicode scalar value, so
   the `á` of `Paraná` is one, and the same letter written as `a` and a
   combining accent is two. A code point is its number, or the character of it
   alone, `code_point{character: 'á'}`. `from_code_points` is the text of
   an array of them, which makes the word again. */
operator spell{word: text} [
    var points := to_code_points{from: word};
    call debug_value{v: length{a: points}};
    call debug_value{v: points[length{a: points}]};
    call debug_value{v: points[length{a: points}] = code_point{character: 'á'}};
    call debug_value{v: from_code_points{from: points} = word};
];

/* A text file's lines, read when the program runs, into the variable
   for `lines`: an array, in the file's order, the first line its element
   1. A relative path is from the directory the program runs in: here,
   the repository's. Reading is an update operator's work, as two reads
   can differ. */
operator list_rivers{} [
    var rivers: array text;
    call load_text_file{path: file_path{text: "examples/rivers.txt"}, out lines: rivers};
    call debug_value{v: rivers};
    call debug_value{v: length{a: rivers}};
    for river in rivers loop [
        if river <> "" then [
            call debug_value{v: river};
        ];
    ];
];

/* A file that can't be read stops the program, unless the call names
   `out errors`: then it gives no lines, and its error, a value of one of
   the prelude's subtypes of `error`. */
operator list_missing{} [
    var rivers: array text;
    var errors: relation { error: error };
    call load_text_file{
        path: file_path{text: "examples/lakes.txt"},
        out lines: rivers,
        out errors: errors,
    };
    call debug_value{v: length{a: rivers}};
    call debug_value{v: errors};
];

/* Lines written to a text file, each ending in a line feed, so that reading
   it gives them back. A file is made if there is none, and what one holds is
   replaced. This one goes in `target`, which the repository ignores. A file
   that can't be written stops the program, unless the call names `out
   errors`. */
operator save_rivers{} [
    var rivers: array text;
    call load_text_file{path: file_path{text: "examples/rivers.txt"}, out lines: rivers};
    call save_text_file{path: file_path{text: "target/saved_rivers.txt"}, lines: rivers};

    var saved: array text;
    call load_text_file{path: file_path{text: "target/saved_rivers.txt"}, out lines: saved};
    call debug_value{v: saved = rivers};

    var errors: relation { error: error };
    call save_text_file{
        path: file_path{text: "target/no/such/directory.txt"},
        lines: rivers,
        out errors: errors,
    };
    call debug_value{v: errors};
];

/* A depth, in metres, below the surface. */
type metres {
    { m: integer },
    constraint m > 0,
};

/* A lake, its name in its own language, and how deep it is. */
heading lake := { name: text, native: text, depth: metres };

/* A CSV file's record that can't be read stops the program, unless the
   call names `out errors`: then each such record is skipped, with its
   error, in `skipped`, and the rest are read. Lake Victoria's depth is
   written in words, and Titicaca's has a sign it shouldn't. */
operator lake_table{out skipped: relation { error: error }} [
    var lakes: array tuple lake;
    call load_csv{
        path: file_path{text: "examples/lakes.csv"},
        header: true,
        columns: tuple { name: 1, native: 2, depth: tuple { m: 3 } },
        out rows: lakes,
        out errors: skipped,
    };
    call debug_value{v: length{a: lakes}};
];

/* A place on Earth, by its latitude and longitude, in degrees, as in
   types.trendy. */
type position {
    { latitude: approximate, longitude: approximate },
    constraint latitude >= -90e0 and latitude <= 90e0,
    constraint longitude > -180e0 and longitude <= 180e0,
};

/* An area, stored in square metres, and written in square kilometres
   too, as in types.trendy's temperatures. */
type area {
    { m2: approximate },
    { km2: approximate }
        to { m2 := km2 * 1e6 }
        from { km2 := m2 / 1e6 },
    constraint m2 >= 0e0,
    order [asc m2],
};

heading river := {
    name: text,
    length_km: integer,
    basin: area,
    reaches_ocean: boolean,
    mouth_at: position,
};

/* A CSV file's records, after its header, read when the program runs,
   into the variable for `rows`: an array of tuples, in the file's order,
   each attribute the field in the column `columns` gives it, counting
   from 1, read as its type. The file's columns have an order and no
   names, so the call names them, whatever the header calls them: its
   `km` is `length_km` here. Columns `columns` doesn't name, here
   `native_name` and `mouth`, are skipped. A value of a type of the
   program's own, here the position of a river's mouth, is read from its
   components' columns, a tuple of them, and selected from them, so a
   record whose components break the type's constraints stops the program,
   writing its line. The components can be those of any of its possible
   representations: a basin's area is read in square kilometres, as the
   file gives it, and stored in square metres. */
operator river_table{} [
    var rivers: array tuple river;
    call load_csv{
        path: file_path{text: "examples/rivers.csv"},
        header: true,
        columns: tuple {
            name: 1,
            length_km: 3,
            basin: tuple { km2: 4 },
            reaches_ocean: 6,
            mouth_at: tuple { latitude: 7, longitude: 8 },
        },
        out rows: rivers,
    };
    call debug_value{v: rivers[1]};
    var table: relation river;
    load table from rivers;
    call debug_table{r: table};
];

/* `main` gives the records skipped as warnings, worth knowing, but not
   failures: the program writes them as it ends, after what it wrote
   before, and exits with 0, as none failed. */
operator main{out errors: relation transaction_collection} [
    call debug_value{v: greeting};
    call debug_value{v: nothing};
    call greet{name: "Ada", punctuation: "!"};
    call greet{name: "é\u{1F600}\"", punctuation: "\n"};
    call greet{name: "", punctuation: ""};
    call spell{word: "Paraná"};
    call spell{word: "Parana\u{301}"};
    call list_rivers{};
    call list_missing{};
    call save_rivers{};
    var skipped: relation { error: error };
    call lake_table{out skipped: skipped};
    call river_table{};
    errors := skipped extend { failed := false };
];
